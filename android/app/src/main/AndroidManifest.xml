<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".JalurApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:manageSpaceActivity="com.google.androidbrowserhelper.trusted.ManageDataLauncherActivity"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Translucent.NoTitleBar">

        <!-- The other half of .well-known/assetlinks.json on tendorethane-code.github.io. -->
        <meta-data
            android:name="asset_statements"
            android:resource="@string/asset_statements" />

        <!-- Required: LauncherActivity enables this (the "Site settings" shortcut) every time it opens
             the site. Undeclared, that threw "Component class ...ManageDataLauncherActivity does not
             exist" and killed the app at launch (apk-v1.0.0-uji1/uji2 on the owner's Infinix,
             Android 15). Bubblewrap's template declares it; also Settings -> Clear data opens it. -->
        <activity android:name="com.google.androidbrowserhelper.trusted.ManageDataLauncherActivity">
            <meta-data
                android:name="android.support.customtabs.trusted.MANAGE_SPACE_URL"
                android:value="${appUrl}" />
        </activity>

        <activity
            android:name=".JalurLauncherActivity"
            android:exported="true"
            android:label="@string/app_name">

            <meta-data
                android:name="android.support.customtabs.trusted.DEFAULT_URL"
                android:value="${appUrl}" />
            <meta-data
                android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR"
                android:resource="@color/bar_light" />
            <meta-data
                android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR_DARK"
                android:resource="@color/bar_dark" />
            <meta-data
                android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR"
                android:resource="@color/bar_light" />
            <meta-data
                android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR_DARK"
                android:resource="@color/bar_dark" />
            <!-- No TWA-capable browser: open in a Custom Tab instead of failing. -->
            <meta-data
                android:name="android.support.customtabs.trusted.FALLBACK_STRATEGY"
                android:value="customtabs" />
            <!-- Text shared to Jalur (Google Maps "Bagikan") goes to the site like the PWA share target. -->
            <meta-data
                android:name="android.support.customtabs.trusted.METADATA_SHARE_TARGET"
                android:resource="@string/share_target" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Links to the site itself open in the app. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="${appHost}"
                    android:pathPrefix="/jalur-maps"
                    android:scheme="https" />
            </intent-filter>

            <!-- Locations from WhatsApp and other apps: "Open with" lists Jalur next to Maps/Waze. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="geo" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <!-- Shown on the launch after a crash (see CrashReport). -->
        <activity
            android:name=".CrashReportActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@android:style/Theme.Material.Light" />
    </application>

    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>
</manifest>
